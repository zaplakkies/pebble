# Copy to .env and fill in. Never commit .env.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Unguessable path for the management pages, e.g. manage-3f9c1a7e2b
MANAGE_PATH=manage-change-me
# Leave empty to use the server's system timezone
TIMEZONE=
SYNC_INTERVAL_S=120
