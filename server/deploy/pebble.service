[Unit]
Description=Pebble screen-time server
After=network-online.target
Wants=network-online.target

[Service]
User=pebble
Group=pebble
WorkingDirectory=/opt/pebble/server
# Allow binding port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# One worker keeps SQLite writes simple; threads handle concurrent agents.
ExecStart=/opt/pebble/server/venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:80 run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
